# Base URL of the Exoria backend (Roblox.Website), no trailing slash
NEXT_PUBLIC_EXORIA_BASE_URL=https://your.domain
# API URL pattern used by the backend: {0} = api site (games, users, ...), {1} = path
NEXT_PUBLIC_EXORIA_API_FORMAT=https://your.domain/apisite/{0}{1}
# Name of the in-game currency shown in the UI
NEXT_PUBLIC_EXORIA_CURRENCY_NAME=Exos
